{
  "name": "monitor-licitacoes",
  "version": "1.3.0",
  "scripts": {
    "ng": "ng",
    "build:ui": "ng build --base-href ./",
    "build:main": "tsc -p electron/tsconfig.json",
    "build": "npm run build:ui && npm run build:main",
    "test": "npm run build:main && node --no-warnings --test \"dist-electron/tests/*.test.js\"",
    "start": "npm run build && electron .",
    "selftest": "npm run build && electron . --selftest",
    "icon": "node scripts/make-icon.mjs",
    "dist": "node scripts/build-portable.mjs",
    "release": "node scripts/release.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "pdfjs-dist": "^5.4.149"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/inter": "5.2.8",
    "@types/node": "^22.20.5",
    "electron": "^45.3.3",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2"
  },
  "main": "dist-electron/main.js",
  "description": "Monitor de Licitações Legislativas - Moreli.Dev",
  "author": "Moreli.Dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/moreliw/monitor-licitacoes.git"
  }
}
