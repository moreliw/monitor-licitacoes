{
  "name": "monitor-licitacoes",
  "version": "1.2.1",
  "scripts": {
    "ng": "ng",
    "build:ui": "ng build --base-href ./",
    "build:main": "tsc -p electron/tsconfig.json",
    "build": "npm run build:ui && npm run build:main",
    "test": "npm run build:main && node --no-warnings --test \"dist-electron/tests/*.test.js\"",
    "start": "npm run build && electron .",
    "selftest": "npm run build && electron . --selftest",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run icon && npm run build && electron-builder --win nsis --x64 --publish never",
    "release": "npm run icon && npm run build && electron-builder --win nsis --x64 --publish always"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "electron-updater": "6.8.11",
    "pdfjs-dist": "^5.4.149"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/inter": "5.2.8",
    "@types/node": "^22.20.5",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2"
  },
  "main": "dist-electron/main.js",
  "description": "Monitor de Licitações Legislativas - Moreli.Dev",
  "author": "Moreli.Dev",
  "build": {
    "appId": "dev.moreli.monitor-licitacoes",
    "productName": "Monitor de Licitações Legislativas",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "!dist-electron/tests/**",
      "dist/monitor-licitacoes/browser/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**",
      "node_modules/@napi-rs/**",
      "dist-electron/pdfworker.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Monitor de Licitações",
      "artifactName": "monitor-licitacoes-setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "menuCategory": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "moreliw",
        "repo": "monitor-licitacoes",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moreliw/monitor-licitacoes.git"
  }
}